{
  "name": "@kantzen-ui/graph",
  "version": "0.1.0",
  "description": "Reusable, data-agnostic force-directed graph canvas for React.",
  "license": "MIT",
  "keywords": [
    "kantzen-ui",
    "react",
    "graph",
    "canvas",
    "visualization"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/graph.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.css dist/",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkepa/kantzen-ui.git",
    "directory": "packages/graph"
  },
  "homepage": "https://github.com/patkepa/kantzen-ui/tree/main/packages/graph#readme",
  "bugs": {
    "url": "https://github.com/patkepa/kantzen-ui/issues"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  }
}
