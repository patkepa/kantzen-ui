{
  "name": "@kantzen-ui/ui",
  "version": "0.1.0",
  "description": "Kantzen UI theme, icons, primitives, interactions, navigation contracts, and React components.",
  "license": "MIT",
  "keywords": [
    "kantzen-ui",
    "react",
    "ui",
    "components",
    "workspace",
    "site"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./interactions": {
      "types": "./dist/interactions/index.d.ts",
      "import": "./dist/interactions/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./theme": {
      "types": "./dist/theme-provider.d.ts",
      "import": "./dist/theme-provider.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.css dist/",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkepa/kantzen-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/patkepa/kantzen-ui/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/patkepa/kantzen-ui/issues"
  },
  "dependencies": {
    "@blueprintjs/icons": "^6.2.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  }
}
