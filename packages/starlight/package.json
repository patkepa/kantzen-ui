{
  "name": "@patkepa/kantzen-starlight",
  "version": "0.1.0",
  "description": "Kantzen UI theme adapter for Astro Starlight documentation sites.",
  "license": "MIT",
  "keywords": [
    "kantzen-ui",
    "astro",
    "starlight",
    "documentation",
    "theme"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-package-css.mjs",
    "test": "node --test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patkepa/kantzen-ui.git",
    "directory": "packages/starlight"
  },
  "homepage": "https://github.com/patkepa/kantzen-ui/tree/main/packages/starlight#readme",
  "bugs": {
    "url": "https://github.com/patkepa/kantzen-ui/issues"
  },
  "dependencies": {
    "@patkepa/kantzen-ui": "0.1.0"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.1"
  }
}
